rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check whether a user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check whether the authenticated user is an administrator.
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.get('admin', false) == true;
    }

    // Check whether the authenticated user owns the requested user document.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New profiles must be created by their owner with safe initial counters.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'email',
          'phone',
          'address',
          'city',
          'pincode',
          'avatarUrl',
          'carsViewedCount',
          'createdAt',
          'updatedAt',
          'loginCount'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'address',
          'city',
          'pincode',
          'avatarUrl',
          'carsViewedCount',
          'createdAt',
          'updatedAt',
          'loginCount'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.pincode is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.carsViewedCount == 0
        && request.resource.data.loginCount == 0
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      // Admins can manage profiles. Owners may update only contact/profile fields.
      // Safe get() defaults allow legacy profiles without optional metadata.
      allow update: if isAdmin() || (
        isOwner(userId)
        && resource.data.get('uid', request.auth.uid) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'email',
            'phone',
            'address',
            'city',
            'pincode',
            'avatarUrl',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.pincode is string
        && request.resource.data.avatarUrl is string
        && request.resource.data.updatedAt is string
        && request.resource.data.get('uid', null)
          == resource.data.get('uid', null)
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null)
        && request.resource.data.get('loginCount', null)
          == resource.data.get('loginCount', null)
        && request.resource.data.get('lastLoginAt', null)
          == resource.data.get('lastLoginAt', null)
        && request.resource.data.get('carsViewedCount', null)
          == resource.data.get('carsViewedCount', null)
      );

      allow delete: if isAdmin();
    }

    // ORDERS
    // Demo checkout data only. Real commerce deployments should create
    // authoritative orders through trusted backend code.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == orderId
        && request.resource.data.status == 'Confirmed'
        && request.resource.data.paymentMethod in [
          'Credit/Debit Card',
          'Net Banking',
          'UPI'
        ]
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.taxBreakdown.grandTotal
          == request.resource.data.taxBreakdown.basePrice
          + request.resource.data.taxBreakdown.totalCharges;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // TEST DRIVES
    match /testDrives/{testDriveId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == testDriveId
        && request.resource.data.status == 'Scheduled';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // LOGIN LOGS: client-side writes are disabled; use trusted backend code.
    match /loginLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ACTIVITY LOGS: client-side writes are disabled; use trusted backend code.
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // COMMUNITY REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.verified == false
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 2000;

      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'rating', 'comment'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 2000
      );

      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    // CARS
    match /cars/{carId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
